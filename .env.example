# ── Database ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=criccast_saas

# ── Session ─────────────────────────────────────────────
# Long random string. Server refuses to start in production if missing.
# Generate with: openssl rand -hex 64
SESSION_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET

# ── App ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Set to 1 when behind a reverse proxy (nginx/Apache/cPanel Passenger) so
# req.ip and the HTTPS redirect honour X-Forwarded-* headers.
TRUST_PROXY=1

# ── Multi-tenant subdomain resolution ───────────────────
# Used by middleware/tenantResolver.js. Set to your apex domain. If you
# deploy on a single custom domain (no subdomains), tenantResolver will
# fall back to the logged-in user's tenant_id, so leaving this unset still
# works — but subdomain-based routing requires it.
BASE_DOMAIN=criccast.app

# ── Rate limiting ───────────────────────────────────────
# Requests per minute per IP (global). SSE stream is skipped from this
# count. 600 comfortably covers ~10 scoreboard tabs polling
# /api/lastbroadcast every 3 s. Raise further if you expect more viewers
# per IP (shared NAT, corporate networks, OBS farms).
RATE_LIMIT_MAX=600

# ── Legacy endpoints ────────────────────────────────────
# The pre-SaaS single-tenant endpoints (/update.php, /sync.php,
# /score.json) accept UNAUTHENTICATED writes against the 'default'
# tenant. They are disabled by default. Only set to 1 if you still run
# the original offline controller against this server.
ALLOW_LEGACY_ENDPOINTS=0

# ── Email (cPanel SMTP or Brevo/Sendinblue free tier) ───
# Leave SMTP_HOST blank to skip email sends without error.
SMTP_HOST=mail.criccast.app
SMTP_PORT=587
SMTP_USER=noreply@criccast.app
SMTP_PASS=your_smtp_password
SMTP_FROM=CricCast <noreply@criccast.app>

# ── Logging ─────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
